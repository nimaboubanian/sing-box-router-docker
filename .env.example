# sing-box router env defaults. Copy to .env (gitignored) to override.
# jsDelivr equivalents are drop-in replacements if raw.githubusercontent.com
# is unreachable: https://cdn.jsdelivr.net/gh/chocolate4u/Iran-sing-box-rules@rule-set/<name>.srs
# Set a *_RULESET_URLS var to empty to disable that rule-set group.
# Overriding LISTEN_PORT requires matching the compose ports: mapping.
LISTEN_PORT=1070
PROXY_HOST=lb
PROXY_PORT=1081
REJECT_RULESET_URLS=https://raw.githubusercontent.com/Chocolate4U/Iran-sing-box-rules/rule-set/geosite-category-ads-all.srs,https://raw.githubusercontent.com/Chocolate4U/Iran-sing-box-rules/rule-set/geosite-malware.srs,https://raw.githubusercontent.com/Chocolate4U/Iran-sing-box-rules/rule-set/geosite-phishing.srs,https://raw.githubusercontent.com/Chocolate4U/Iran-sing-box-rules/rule-set/geosite-cryptominers.srs
DIRECT_DOMAIN_RULESET_URLS=https://raw.githubusercontent.com/Chocolate4U/Iran-sing-box-rules/rule-set/geosite-ir.srs
DIRECT_IP_RULESET_URLS=https://raw.githubusercontent.com/Chocolate4U/Iran-sing-box-rules/rule-set/geoip-ir.srs
DOH_SERVER=1.1.1.1  # use an IP — a hostname resolves via local (Iranian) DNS and can be poisoned
LOG_LEVEL=warn
# Extra raw destinations, comma-separated (empty = none).
# Overlap between lists: reject > proxy > direct (first match wins).
# EXTRA_REJECT_DOMAINS=ads.example.com
# EXTRA_REJECT_IPS=10.9.0.0/24
# EXTRA_PROXY_DOMAINS=force-proxy.example.ir
# EXTRA_PROXY_IPS=10.10.0.0/24
# EXTRA_DIRECT_DOMAINS=example.com,.net.org
# EXTRA_DIRECT_IPS=10.8.0.0/24
